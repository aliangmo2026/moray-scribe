# Copy to .env and adjust as needed. Every key uses the MORAY_SCRIBE_ prefix.
# List values are parsed as JSON arrays by pydantic-settings.

MORAY_SCRIBE_OLLAMA_HOST=http://localhost:11434
MORAY_SCRIBE_MODEL_DESCRIBER=qwen2.5-coder:14b
MORAY_SCRIBE_MODEL_SUMMARIZER=qwen2.5-coder:7b

MORAY_SCRIBE_MAX_NODES=200
MORAY_SCRIBE_MAX_EDGES=500
MORAY_SCRIBE_MAX_FILE_SIZE_KB=512

# 600s is the empirical default for the doc stage with a 7B model: drafting a
# complex architecture draft typically takes 2-8 minutes on CPU. Lower it for
# scan/graph-only workflows, raise it (up to 3600) for slow hardware.
MORAY_SCRIBE_REQUEST_TIMEOUT_S=600
MORAY_SCRIBE_MAX_RETRIES=2
MORAY_SCRIBE_TEMPERATURE=0.1

MORAY_SCRIBE_INCLUDE=["**/*.py"]
MORAY_SCRIBE_EXCLUDE=["**/test_*.py", "**/__pycache__/**", "**/.venv/**"]

MORAY_SCRIBE_OUT_DIR=out
MORAY_SCRIBE_MAX_OUTPUT_TOKENS=4096
